<?xml version="1.0"?>
<!--
  Ackermann chassis for PR06, transcribed from the course-kit SDF
  .course-kit/v1/models/course_ackermann/model.sdf — dimensions only, no
  Gazebo plugins and no sensors. Frames follow REP-103: x forward, y left,
  z up; wheels spin about +y, steering knuckles about +z.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">

  <!-- chassis box and inertia from the SDF body_collision/body_visual -->
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width" value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="body_mass" value="12.0"/>
  <xacro:property name="body_z" value="0.12"/>
  <xacro:property name="body_ixx" value="0.55"/>
  <xacro:property name="body_iyy" value="1.10"/>
  <xacro:property name="body_izz" value="1.40"/>

  <!-- wheels: SDF cylinders radius 0.12, length 0.07, mass 0.8 -->
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="wheel_i_roll" value="0.006"/>
  <xacro:property name="wheel_i_spin" value="0.003"/>

  <!-- axle placement: front axle x +0.40, rear x -0.40, wheels at y +/-0.31 -->
  <xacro:property name="axle_x" value="0.40"/>
  <xacro:property name="wheel_y" value="0.31"/>
  <xacro:property name="knuckle_mass" value="0.2"/>
  <xacro:property name="steer_limit" value="0.55"/>

  <!-- sensor mast: SDF camera/lidar/imu link pose 0.28 0 0.38 -->
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_z" value="0.38"/>
  <xacro:property name="sensor_mass" value="0.033333333333"/>
  <xacro:property name="sensor_i" value="0.000333333333"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_ixx}" ixy="0" ixz="0" iyy="${body_iyy}" iyz="0" izz="${body_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>

  <!-- Wheel link frame is aligned with the chassis (REP-103); the cylinder
       geometry is rotated onto +y, so the revolute axis stays "0 1 0". -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- cylinder spin axis is +y here: the small inertia sits on y -->
        <inertia ixx="${wheel_i_roll}" ixy="0" ixz="0" iyy="${wheel_i_spin}" iyz="0" izz="${wheel_i_roll}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- front wheels hang on steering knuckles, exactly as in the SDF -->
  <xacro:macro name="front_axle" params="side y">
    <link name="front_${side}_knuckle">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${knuckle_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${axle_x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-${steer_limit}" upper="${steer_limit}" effort="25" velocity="2.0"/>
    </joint>
    <xacro:wheel name="front_${side}_wheel"/>
    <joint name="front_${side}_wheel_joint" type="revolute">
      <parent link="front_${side}_knuckle"/>
      <child link="front_${side}_wheel"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159" upper="3.14159" effort="10" velocity="20.0"/>
    </joint>
  </xacro:macro>

  <!-- rear wheels are fixed to the chassis directly -->
  <xacro:macro name="rear_axle" params="side y">
    <xacro:wheel name="rear_${side}_wheel"/>
    <joint name="rear_${side}_wheel_joint" type="revolute">
      <parent link="base_link"/>
      <child link="rear_${side}_wheel"/>
      <origin xyz="-${axle_x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159" upper="3.14159" effort="10" velocity="20.0"/>
    </joint>
  </xacro:macro>

  <xacro:front_axle side="left" y="${wheel_y}"/>
  <xacro:front_axle side="right" y="-${wheel_y}"/>
  <xacro:rear_axle side="left" y="${wheel_y}"/>
  <xacro:rear_axle side="right" y="-${wheel_y}"/>

  <!-- fixed sensor frames: parent must stay base_link (PR06 defect lives here) -->
  <xacro:macro name="sensor" params="prefix parent:=base_link">
    <link name="${prefix}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${sensor_mass}"/>
        <inertia ixx="${sensor_i}" ixy="0" ixz="0" iyy="${sensor_i}" iyz="0" izz="${sensor_i}"/>
      </inertial>
    </link>
    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
      <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:sensor prefix="camera"/>
  <xacro:sensor prefix="lidar"/>
  <xacro:sensor prefix="imu"/>

</robot>
